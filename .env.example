# Copy this file to ".env" and fill it in. NEVER share your .env file or post the token anywhere.

# From the Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Right-click your server icon -> Copy Server ID   (needs Developer Mode, see README)
GUILD_ID=

# Right-click your own name -> Copy User ID. Only this person can use /santa-admin.
ORGANIZER_ID=

# Your timezone, for reminders and the daily countdown. Examples:
# America/Edmonton, America/Vancouver, America/Toronto, America/New_York, America/Chicago,
# America/Los_Angeles, Europe/London   (full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TIMEZONE=America/New_York

# Hour (0-23) to post the daily countdown / send automatic ship-by nudges
DAILY_POST_HOUR=10

# Optional: turns on /gift-ideas. Get a key at https://console.anthropic.com (pay-as-you-go, pennies per use)
ANTHROPIC_API_KEY=
