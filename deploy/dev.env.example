# Running the same compose.yaml on a PC (contract §10).
#
#   cp deploy/dev.env.example deploy/dev.env
#   cp .env.example deploy/dev.secrets.env      # then fill in a TEST bot's token/server, never the real one
#   docker compose --env-file deploy/dev.env up --build
#
# Use --env-file rather than copying this to ./.env: on the PC, ./.env is the bot's own secrets file.
# Paths are relative to the repo root (where compose.yaml lives). Data lands in ./.data/state
# (santa.db, logs/, backup/); put santa-letter.png in ./.data/state/assets/ to get the letter picture.
# Never run a dev copy with the production token while the real bot is running (double replies).
KRASNODAR_APP=santa
KRASNODAR_REF=dev
KRASNODAR_DATA=./.data
KRASNODAR_SECRETS=./deploy/dev.secrets.env
